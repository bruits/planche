root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.md]
indent_size = unset
indent_style = space
trim_trailing_whitespace = false

[{*.yml,*.yaml}]
indent_style = space
indent_size = 2

[*.{ts,js,cjs,mjs,json,css,html}]
indent_style = space
indent_size = 2
